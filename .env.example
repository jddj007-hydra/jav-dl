# Web
# PORT=8787
# DATA_DIR=./data
# DOWNLOAD_DIR=./downloads

# aria2
ARIA2_RPC=http://127.0.0.1:6800/jsonrpc
ARIA2_SECRET=jav-dl-rpc

# 查站代理（BT 不走代理）
PROXY_ENABLED=false
PROXY_URL=http://127.0.0.1:7890

# JavBus 没有这部片（HTTP 404）时才回退 JavDB。默认 https://javdb.com；留空则关闭回退。
# Cookie 可空。设置页留空保存不改已填写的值。
# JAVDB_BASE=https://javdb.com
# JAVDB_COOKIE=

# 可选 HTTP Basic
# AUTH_USER=
# AUTH_PASS=

# 下载后端：aria2 | xunlei（设置页也可改，写入 data/config.json）
DOWNLOADER=aria2
# XUNLEI_URL=http://127.0.0.1:2345
# XUNLEI_USERNAME=
# XUNLEI_PASSWORD=
# XUNLEI_DEVICE_NAME=群晖-xunlei
