# Web
# PORT=8787
# DATA_DIR=./data
# DOWNLOAD_DIR=./downloads

# aria2
ARIA2_RPC=http://127.0.0.1:6800/jsonrpc
ARIA2_SECRET=jav-dl-rpc

# 查站代理（BT 不走代理）
PROXY_ENABLED=false
PROXY_URL=http://127.0.0.1:7890

# 可选 HTTP Basic
# AUTH_USER=
# AUTH_PASS=

# 下载后端：aria2 | xunlei（设置页也可改，写入 data/config.json）
DOWNLOADER=aria2
# XUNLEI_URL=http://127.0.0.1:2345
# XUNLEI_USERNAME=
# XUNLEI_PASSWORD=
# XUNLEI_DEVICE_NAME=群晖-xunlei
